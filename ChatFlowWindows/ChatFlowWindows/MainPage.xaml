<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChatFlowWindows.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ChatFlowWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Device Discovery -->
        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <Image Source="Assets/ic_chatflow_icon.svg" Width="32" Height="32" VerticalAlignment="Center" />
                <TextBlock Text="Chat Flow" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="ScanButton" Content="Scan for Devices" Click="ScanButton_Click" HorizontalAlignment="Stretch" />
            <ListView x:Name="DeviceListView" SelectionChanged="DeviceListView_SelectionChanged" Height="300" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="4">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                            <TextBlock Text="{Binding Id}" Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button x:Name="HostButton" Content="Start Hosting" Click="HostButton_Click" HorizontalAlignment="Stretch" />
            <TextBlock x:Name="StatusTextBlock" Text="Status: Idle" Margin="0,8,0,0" FontStyle="Italic" />
        </StackPanel>

        <!-- Right Pane: Chat -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView x:Name="ChatListView" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,8">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4">
                            <TextBlock Text="{Binding Sender}" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="MessageTextBox" PlaceholderText="Type a message..." KeyDown="MessageTextBox_KeyDown" />
                <Button Grid.Column="1" Content="Send" Click="SendButton_Click" Margin="8,0,0,0" />
            </Grid>
        </Grid>
    </Grid>
</Page>
